# Atelier keeps its own state outside the repo (XDG user data dirs).
# Nothing here is generated by a build — the project has no build step.

# Dependencies (Atelier itself has none; this guards contributors' scratch work)
node_modules/

# Environment and secrets
.env
.env.*
*.pem
*.key

# Tracker database sidecars, when a project opts into an in-repo tracker
.beads/*.db
.beads/*.db-wal
.beads/*.db-shm
.beads/last-touched
.beads/*.lock

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local run artifacts
*.log

# Generated by test-system/leak-report.mjs (ATT-011 artifact, regenerated per run)
leak-report.json

# Generated by scripts/flake-rate.mjs (nightly measurement artifacts)
flake-rate-*.json

# Private material that must never enter this (public) history. Planning specs,
# lane reports and audit bundles live in the private `atelier-internal` repo;
# `specs/` here is a local symlink to that checkout. The Moss web renderer is
# built from a private repository and is dropped in locally to enable the
# opt-in `?engine=moss` path; its screenshots are regenerated by the browser
# tests. test-system/public-hygiene.test.mjs enforces all three.
/specs
/specs/
themes/cozy-village/vendor/moss-web-renderer/
docs/evidence/moss-engine-mvp/
